# Response headers for the Cloudflare Workers static-assets deployment.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# HTML deliberately keeps Cloudflare's default ("public, max-age=0,
# must-revalidate"): every deploy renames the hashed JS/CSS chunks, so a page
# cached past a deploy references assets that no longer exist and renders
# without scripts or styles. Only the content-hashed build output is cached
# for long.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the workers.dev hostnames (visawhen.<account>.workers.dev and the
# per-version <id>-visawhen.<account>.workers.dev previews) out of search
# results; visawhen.com is the canonical host.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
