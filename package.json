{
  "name": "visawhen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn ensure-db && next dev --webpack",
    "build": "yarn ensure-db && next build --webpack && next-sitemap && node scripts/check-redirects.mjs",
    "export": "yarn build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ensure-db": "cd data/consulates && gunzip -kf dump/backlogs.ndjson.gz && sqlite-diffable load consulates.sqlite dump/ --replace"
  },
  "dependencies": {
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@visx/curve": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "lodash": "^4.18.1",
    "next": "^16.3.2",
    "numeral": "^2.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-schemaorg": "^2.0.1",
    "schema-dts": "^2.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/numeral": "^2.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.3"
  },
  "dependenciesMeta": {
    "sqlite3": {
      "built": true
    }
  },
  "browserslist": [
    ">1%",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "packageManager": "yarn@4.18.0"
}
