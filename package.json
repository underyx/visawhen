{
  "name": "visawhen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run ensure-db && next dev --webpack",
    "build": "bun run ensure-db && next build --webpack && next-sitemap && node scripts/check-redirects.mjs",
    "export": "bun run build",
    "lint": "bun lint --no-script",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-ts-hooks.mjs --test 'components/*.test.ts' 'api/*.test.ts' 'scripts/*.test.mjs'",
    "ensure-db": "cd data/consulates && gunzip -kf dump/backlogs.ndjson.gz && sqlite-diffable load consulates.sqlite dump/ --replace"
  },
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@visx/curve": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "lodash": "^4.18.1",
    "next": "^16.4.3",
    "numeral": "^2.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-schemaorg": "^2.0.1",
    "schema-dts": "^2.1.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/numeral": "^2.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^6.0.3"
  },
  "browserslist": [
    ">1%",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "trustedDependencies": [
    "sqlite3"
  ]
}
