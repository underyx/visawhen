{
  "name": "visawhen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run ensure-db && bun --bun next dev --webpack",
    "build": "bun run ensure-db && bun --bun next build --webpack && bun scripts/sitemap.ts && bun scripts/check-redirects.mjs",
    "export": "bun run build",
    "lint": "bun lint --no-script",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test ./components ./api ./scripts ./data",
    "ensure-db": "bun scripts/load-consulates-db.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@visx/curve": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "schema-dts": "^2.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "typescript": "^6.0.3",
    "unpdf": "^1.9.1"
  },
  "browserslist": [
    ">1%",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "trustedDependencies": []
}
