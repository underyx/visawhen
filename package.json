{
  "name": "visawhen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn ensure-db && next dev --webpack",
    "build": "yarn ensure-db && next build --webpack && next-sitemap",
    "export": "yarn build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ensure-db": "cd data/consulates && gunzip -kf dump/backlogs.ndjson.gz && sqlite-diffable load consulates.sqlite dump/ --replace"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lodash": "^4.18.1",
    "next": "^16.3.2",
    "numeral": "^2.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-schemaorg": "^2.0.1",
    "schema-dts": "^2.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.2",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/numeral": "^2.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    ">1%",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "packageManager": "yarn@4.18.0"
}
