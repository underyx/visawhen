// Cloudflare Workers static-assets deployment of the exported site, which
// serves visawhen.com. Deployed by .github/workflows/deploy.yml
// (`wrangler deploy`), which also describes how requests reach it.
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "visawhen",
  // Must not be later than the current Workers runtime release; bump from
  // time to time.
  "compatibility_date": "2026-08-01",
  // Assets-only Worker: there is no "main" script, so requests are answered
  // straight from the asset store and are not billed as Worker invocations.
  "assets": {
    "directory": "./out",
    // /nvc -> out/nvc.html and /nvc/ redirects to /nvc, matching the Next.js
    // export layout (no trailingSlash). The Worker redirects with a 307, and
    // redirects /nvc.html and /index.html too; nothing links to those forms.
    "html_handling": "auto-trailing-slash",
    // Serve out/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // A route rather than a custom domain: the Worker answers every request to
  // visawhen.com, so the zone's DNS records for it only need to be proxied;
  // where they point is never used. They still point at Netlify, which
  // served visawhen.com until 2026-10-03 and no longer gets deploys, so
  // without this route the site would be down or out of date.
  // www.visawhen.com needs no route: a redirect rule in the dashboard sends
  // it to https://visawhen.com.
  "routes": [{ "pattern": "visawhen.com/*", "zone_name": "visawhen.com" }],
  // Also serves visawhen.<account>.workers.dev, kept out of search results by
  // public/_headers.
  "workers_dev": true
}
