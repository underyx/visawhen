// Cloudflare Workers static-assets deployment of the exported site, which
// serves visawhen.com. Deployed by .github/workflows/deploy.yml
// (`wrangler deploy`), which also describes how requests reach it.
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "visawhen",
  // Must not be later than the current Workers runtime release; bump from
  // time to time.
  "compatibility_date": "2026-08-01",
  // Assets-only Worker: there is no "main" script, so requests are answered
  // straight from the asset store and are not billed as Worker invocations.
  "assets": {
    "directory": "./out",
    // /nvc -> out/nvc.html and /nvc/ redirects to /nvc, matching the Next.js
    // export layout (no trailingSlash) and Netlify's pretty URLs. The Worker
    // redirects with a 307 (Netlify with a 301), and redirects /nvc.html and
    // /index.html too, which Netlify serves; nothing links to those forms.
    "html_handling": "auto-trailing-slash",
    // Serve out/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // A route rather than a custom domain: the Worker answers every request to
  // visawhen.com, and the zone's DNS records for it, which still point at
  // Netlify, only need to stay proxied, so nothing in DNS changes. Deleting
  // the route under the Worker's Domains & Routes in the dashboard hands
  // visawhen.com back to Netlify at once; remove it here too, or the next
  // deploy adds it again. www.visawhen.com needs no route: a redirect rule in
  // the dashboard sends it to https://visawhen.com.
  "routes": [{ "pattern": "visawhen.com/*", "zone_name": "visawhen.com" }],
  // Also serves visawhen.<account>.workers.dev, kept out of search results by
  // public/_headers.
  "workers_dev": true
}
